load("@rules_proto//proto:defs.bzl", "proto_library", "proto_lang_toolchain")
load("@rules_cc//cc:defs.bzl", "cc_proto_library")
load("@com_github_grpc_grpc//bazel:cc_grpc_library.bzl", "cc_grpc_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "hello_proto",
    srcs = ["landing.proto"],
)

cc_proto_library(
    name = "hello_cc_proto",
    deps = [":hello_proto"],
)

cc_grpc_library(
    name = "hello_cc_grpc",
    srcs = [":hello_proto"],
    grpc_only = True,
    deps = [":hello_cc_proto"],
)

cc_library(
    name = "system_proto_runtime_headers",
    includes = [
        "../external/abseil-cpp~",
        "../external/protobuf~/src",
        "../external/protobuf~",
    ],
    deps = [
        "@com_google_absl//absl/base",
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/log:absl_log",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:optional",
    ],
)

# The protobuf host protoc built by Bazel can segfault on Windows
# (Exit -1073741819 / 0xC0000005), deadlocking well-known proto codegen
# (api_proto [for tool]). On Windows, expose a system protoc exactly matched
# to the resolved protobuf series: D:\zoo\bin\protoc27.2.exe (libprotoc 27.2)
# matches protobuf@27.2 in MODULE.bazel. On macOS/Linux this target produces
# a harmless stub since the default Bazel-built protoc is used instead.
# The header-only runtime shim above gives generated well-known-type compile
# actions the protobuf/Abseil include roots without depending on
# @com_google_protobuf//:protobuf, which would create a WKT dependency cycle.
genrule(
    name = "system_protoc",
    srcs = [],
    outs = ["protoc.exe"],
    cmd = select({
        "@platforms//os:windows": "cp /d/zoo/bin/protoc27.2.exe $@",
        "//conditions:default": "echo '#!/bin/sh' > $@ && echo 'echo system_protoc is only functional on Windows >&2; exit 1' >> $@ && chmod +x $@",
    }),
    executable = True,
)

proto_lang_toolchain(
    name = "system_cc_toolchain",
    command_line = "--cpp_out=$(OUT)",
    runtime = ":system_proto_runtime_headers",
)
