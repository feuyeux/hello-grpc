common --enable_platform_specific_config

# Keep generated code and all native targets on the repository's C++ baseline.
build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17
build:windows --cxxopt=/std:c++17
build:windows --host_cxxopt=/std:c++17
build:windows --define=grpc_no_xds=true

# The Bazel-built protobuf host compiler is unstable on the supported Windows
# toolchain. Use the pinned protoc 27.2 targets declared in protos/BUILD.bazel.
build:windows --proto_compiler=//protos:system_protoc
build:windows --proto_toolchain_for_cc=//protos:system_cc_toolchain

# Abseil 20240116.0 uses a Clang builtin spelling deprecated by current macOS
# toolchains. Keep the project baseline reproducible without turning unrelated
# warnings into non-errors.
build:macos --copt=-Wno-error=deprecated-builtins
build:macos --host_copt=-Wno-error=deprecated-builtins

test --test_output=errors
test --test_summary=detailed

try-import %workspace%/.bazelrc.user
