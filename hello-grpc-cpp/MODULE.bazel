"""This is a Bazel module file."""

module(
    name = "hello-grpc-cpp",
    # Ensure the correct order of dependency definitions
    version = "1.0.0",
)

## 1 hello_cc_grpc dependencies !! Keep the order !!

# https://registry.bazel.build/modules/rules_cc
bazel_dep(name = "rules_cc", version = "0.1.2", repo_name = "rules_cc")

# https://registry.bazel.build/modules/rules_proto
# Pinned to 6.0.2 so the root protobuf version below controls the C++ runtime
# graph. Newer rules_proto releases force protobuf versions whose self-built
# host protoc is unreliable on Windows.
bazel_dep(name = "rules_proto", version = "6.0.2")

# https://registry.bazel.build/modules/apple_support
bazel_dep(name = "apple_support", version = "1.23.1", repo_name = "build_bazel_apple_support")

# https://registry.bazel.build/modules/rules_apple
bazel_dep(name = "rules_apple", version = "3.17.0", repo_name = "build_bazel_rules_apple")

# https://registry.bazel.build/modules/googleapis
bazel_dep(name = "googleapis", version = "0.0.0-20240819-fe8ba054a", repo_name = "com_google_googleapis")

# https://registry.bazel.build/modules/protobuf
# Matched to D:\zoo\bin\protoc27.2.exe in //protos:system_protoc.
bazel_dep(name = "protobuf", version = "27.2", repo_name = "com_google_protobuf")

# https://registry.bazel.build/modules/grpc
bazel_dep(name = "grpc", version = "1.66.0", repo_name = "com_github_grpc_grpc")

# opentelemetry-cpp is intentionally NOT a bazel_dep here. Every BCR
# release compatible with this project's pinned grpc/protobuf graph ships
# a `sdk/src/resource`/`sdk/src/metrics` BUILD file whose glob() matches
# nothing, which fails analysis for any target depending on it (see
# common/otel.cc for the full explanation). common/otel.cc is an
# env-gated no-op stub instead, so //common:otel has no OpenTelemetry
# C++ SDK dependency.

## 2 hello_utils dependencies

# https://registry.bazel.build/modules/glog
bazel_dep(name = "glog", version = "0.7.1", repo_name = "com_github_google_glog")

# https://registry.bazel.build/modules/abseil-cpp
bazel_dep(name = "abseil-cpp", version = "20240116.0", repo_name = "com_google_absl")

## 3 hello_server dependencies

# https://registry.bazel.build/modules/catch2
bazel_dep(name = "catch2", version = "3.8.0")

bazel_dep(name = "googletest", version = "1.16.0")
