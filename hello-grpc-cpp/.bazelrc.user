# User-specific Bazel configuration
# Enable repository cache to speed up builds
build --repository_cache=~/.cache/bazel/repository_cache
fetch --repository_cache=~/.cache/bazel/repository_cache

# Use local distribution directory
build --distdir=~/.cache/bazel/repository_cache
fetch --distdir=~/.cache/bazel/repository_cache

# Note: For GitHub rate limit issues, wait for the limit to reset (usually 1 hour)
# or use a different network connection

# Windows: the protobuf host protoc built by Bazel can segfault
# (Exit -1073741819 / 0xC0000005), deadlocking well-known proto codegen
# (api_proto [for tool]). Use the system protoc 27.2 (//protos:system_protoc
# -> D:\zoo\bin\protoc27.2.exe), matched to the resolved protobuf@27.2, for the
# default proto compiler + the C++ proto toolchain.
build --proto_compiler=//protos:system_protoc
build --proto_toolchain_for_cc=//protos:system_cc_toolchain
