  "main": "src/server/index.js",
  "directories": {
    "test": "test"
  },
  "keywords": [],
  "author": "",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/feuyeux/hello-grpc-nodejs/issues"
  },
  "homepage": "https://github.com/feuyeux/hello-grpc-nodejs#readme"
