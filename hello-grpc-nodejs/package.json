{
  "name": "hello-grpc",
  "version": "0.1.0",
  "description": "hello grpc",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.7.15",
    "@grpc/reflection": "^1.0.4",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/instrumentation-grpc": "^0.219.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "async": "^3.2.5",
    "fast-linked-list": "^3.2.3",
    "google-protobuf": "^3.21.2",
    "grpc-health-check": "^2.0.1",
    "lodash": "^4.17.21",
    "minimist": "^1.2.8",
    "uuid": "11.1.1",
    "winston": "^3.10.0"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "overrides": {
    "@mapbox/node-pre-gyp": {
      "tar": "7.5.20"
    },
    "mocha": {
      "diff": "8.0.3",
      "serialize-javascript": "7.0.7"
    }
  },
  "devDependencies": {
    "grpc-tools": "^1.12.4",
    "mocha": "11.2.2"
  },
  "scripts": {
    "test": "mocha",
    "server": "node src/server/index.js",
    "client": "node src/client/index.js",
    "start": "node src/server/index.js",
    "generate-proto": "grpc_tools_node_protoc --js_out=import_style=commonjs,binary:./src/proto --grpc_out=grpc_js:./src/proto -I ../proto ../proto/landing.proto"
  },
  "repository": {
